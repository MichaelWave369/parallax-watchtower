{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michaelwave369.github.io/parallax-watchtower/schemas/news-briefing.schema.json",
  "title": "Watchtower deterministic public briefing v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "generatedAt",
    "from",
    "through",
    "windowHours",
    "rankingMethod",
    "coverage",
    "items",
    "references",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "phi.watchtower.briefing.v1"
    },
    "version": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "from": {
      "type": "string",
      "format": "date-time"
    },
    "through": {
      "type": "string",
      "format": "date-time"
    },
    "windowHours": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 744
    },
    "rankingMethod": {
      "type": "string",
      "maxLength": 1000
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputCount",
        "acceptedCount",
        "inWindowCount",
        "matchedCount",
        "includedCount",
        "excludedUndated",
        "duplicatesRemoved",
        "omittedCount",
        "staleCount",
        "sourceCount",
        "truncatedInput",
        "oldestRetrievalAt",
        "newestRetrievalAt"
      ],
      "properties": {
        "inputCount": {
          "type": "integer",
          "minimum": 0
        },
        "acceptedCount": {
          "type": "integer",
          "minimum": 0
        },
        "inWindowCount": {
          "type": "integer",
          "minimum": 0
        },
        "matchedCount": {
          "type": "integer",
          "minimum": 0
        },
        "includedCount": {
          "type": "integer",
          "minimum": 0
        },
        "excludedUndated": {
          "type": "integer",
          "minimum": 0
        },
        "duplicatesRemoved": {
          "type": "integer",
          "minimum": 0
        },
        "omittedCount": {
          "type": "integer",
          "minimum": 0
        },
        "staleCount": {
          "type": "integer",
          "minimum": 0
        },
        "sourceCount": {
          "type": "integer",
          "minimum": 0
        },
        "truncatedInput": {
          "type": "boolean"
        },
        "oldestRetrievalAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "newestRetrievalAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "publisher",
          "sourceId",
          "kind",
          "evidenceType",
          "publishedAt",
          "eventAt",
          "modifiedAt",
          "retrievedAt",
          "timeBasis",
          "freshness",
          "region",
          "topics",
          "url",
          "referenceIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,159}$"
          },
          "title": {
            "type": "string",
            "maxLength": 280
          },
          "publisher": {
            "type": "string",
            "maxLength": 120
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,159}$"
          },
          "kind": {
            "enum": [
              "article",
              "official_statement",
              "public_data",
              "research"
            ]
          },
          "evidenceType": {
            "enum": [
              "official_statement",
              "primary_documentation",
              "independent_reporting",
              "secondary_reporting",
              "uncorroborated_claim"
            ]
          },
          "publishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "eventAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "modifiedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "timeBasis": {
            "enum": [
              "publication",
              "event",
              "modification"
            ]
          },
          "freshness": {
            "enum": [
              "fresh",
              "stale",
              "unknown"
            ]
          },
          "region": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "label",
              "precision"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,24}$"
              },
              "label": {
                "type": "string",
                "maxLength": 120
              },
              "precision": {
                "enum": [
                  "global",
                  "country",
                  "region",
                  "point"
                ]
              }
            }
          },
          "topics": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 12,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            }
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "referenceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 120
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "publisher",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "publisher": {
            "type": "string",
            "maxLength": 120
          },
          "title": {
            "type": "string",
            "maxLength": 280
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  }
}
