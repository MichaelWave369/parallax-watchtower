{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michaelwave369.github.io/parallax-watchtower/schemas/news-snapshot.schema.json",
  "title": "Watchtower public news cache v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAt",
    "sources",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "phi.watchtower.news.v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "lastSuccessAt",
          "lastFailureAt",
          "attemptedAt",
          "recordCount",
          "message",
          "consecutiveFailures",
          "nextAttemptAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,159}$"
          },
          "status": {
            "enum": [
              "ok",
              "error",
              "unavailable"
            ]
          },
          "lastSuccessAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastFailureAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "attemptedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "recordCount": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string",
            "maxLength": 240
          },
          "consecutiveFailures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "nextAttemptAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "records": {
      "type": "array",
      "maxItems": 600,
      "items": {
        "$ref": "news-record.schema.json"
      }
    }
  }
}
